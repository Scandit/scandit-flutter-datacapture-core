	<key>IDEWorkspaceSharedSettings_DerivedDataCustomLocation</key>
	<string>$(SRCROOT)/DerivedData</string>
	<key>IDEWorkspaceSharedSettings_DerivedDataLocationStyle</key>
	<integer>2</integer>
	<key>PreviewsEnabled</key>
	<false/>
</dict>
</plist>
